{
  "name": "signbit-client",
  "private": true,
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signbit-io/fountain.git"
  },
  "homepage": "https://signbit.io/download",
  "bugs": {
    "url": "https://github.com/signbit-io/fountain/issues"
  },
  "version": "0.6.5",
  "type": "module",
  "scripts": {
    "predev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-dev-ports.ps1",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-dev.ps1",
    "android:play": "powershell -NoProfile -Command \"$env:SIGNBIT_PLAY='1'; npx tauri android build --aab\"",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:report": "node scripts/i18n.mjs missing",
    "i18n:get": "node scripts/i18n.mjs get",
    "i18n:set": "node scripts/i18n.mjs set",
    "i18n:apply": "node scripts/i18n.mjs apply"
  },
  "dependencies": {
    "@bitcoinerlab/descriptors": "^3.1.7",
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@fontsource-variable/epilogue": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@scure/bip39": "^1.6.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "bip32": "^4.0.0",
    "bitcoinjs-lib": "^6.1.7",
    "bs58check": "^4.0.0",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.2",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.10"
  }
}
