<?xml version="1.0" encoding="utf-8"?>
<!--
  Android ADAPTIVE-ICON BACKGROUND for SignBit.

  ⚠️ Replaces two generated defaults: the Android Studio template (a green grid) and the flat
  #fff colour `tauri icon` points mipmap-anydpi-v26/ic_launcher.xml at. White showed round the
  mark because the foreground is transparent outside it. Keep ic_launcher.xml pointing at this
  @drawable when regenerating icons.

  FLAT #16181f since 2026-09-27 — the same solid tile as the new stacked "S over B" mark
  (scripts/gen-icon.mjs, shared with the platform favicon). No edge detail: the launcher masks
  this to a circle / squircle / rounded square.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:fillColor="#16181F" android:pathData="M0,0h108v108h-108z"/>
</vector>
